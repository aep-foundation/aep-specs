{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aep.foundation/conformance/capability-manifest.schema.json",
  "title": "AEP conformance capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "implementation", "claims"],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "profiles"],
        "properties": {
          "role": {
            "enum": ["agent", "service", "platform"]
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "core-http",
                "claims",
                "api-key",
                "basic",
                "oauth-bearer",
                "platform-hosted-identity"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": { "const": "platform" }
              }
            },
            "then": {
              "properties": {
                "profiles": {
                  "const": ["platform-hosted-identity"]
                }
              }
            },
            "else": {
              "properties": {
                "profiles": {
                  "contains": { "const": "core-http" }
                }
              }
            }
          }
        ]
      }
    }
  }
}
