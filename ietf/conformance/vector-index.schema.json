{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aep.foundation/conformance/vector-index.schema.json",
  "title": "AEP conformance vector index",
  "type": "object",
  "additionalProperties": false,
  "required": ["index_version", "vectors"],
  "properties": {
    "index_version": {
      "const": "1"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9-]+/)+[a-z0-9-]+\\.json$"
      }
    }
  }
}
